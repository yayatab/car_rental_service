# ==========================================
# JetBrains IDEs (PyCharm, IntelliJ, etc.)
# ==========================================
.idea/
*.iws
*.iml
*.ipr
out/

# If you want to share project dictionary/code style with your team, 
# uncomment the line below and ignore individual files instead:
# !.idea/scopes/
# !.idea/projectCodeStyleWithIdea.xml

# ==========================================
# uv (Python Package & Project Manager)
# ==========================================
# Virtual environment created by `uv venv`
.venv/

# Environment file (contains local secrets)
.env

# Cache directory generated by uv operations
.uv/

# Build artifacts generated by `uv build`
dist/
build/
*.egg-info/

# ==========================================
# General Python & Testing Exclusions
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

./logs/